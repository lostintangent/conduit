{
  "name": "conduit",
  "productName": "Conduit",
  "description": "A terminal-centric IDE (a \"DIY-DE\"), that's built for task parallelization with coding agents.",
  "main": ".vite/build/main.js",
  "version": "0.3.7",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "cross-env ELECTRON_FORGE_PACKAGING=1 electron-forge package",
    "make": "cross-env ELECTRON_FORGE_PACKAGING=1 electron-forge make",
    "release": ": ${CONDUIT_APPLE_ID_PASSWORD:?is required to sign and notarize} && cross-env ELECTRON_FORGE_PACKAGING=1 electron-forge publish",
    "lint": "oxlint",
    "lint:ci": "oxlint --quiet",
    "format": "biome format --write ./src",
    "rebuild": "electron-rebuild",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "cross-env": "^10.1.0",
    "electron": "^39.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "ignore": "^7.0.14",
    "immer": "^11.2.10",
    "jotai": "^2.20.3",
    "jotai-immer": "^0.4.3",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.54.0",
    "node-pty": "^1.1.0",
    "path-browserify": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "simple-git": "^3.36.0",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "biome format --write ./src",
      "oxlint"
    ],
    "**/*.{json,css,md}": "biome format --write ./src"
  }
}
