{
  "name": "conduit",
  "productName": "Conduit",
  "description": "A terminal-centric IDE (a \"DIY-DE\"), that's built for task parallelization with coding agents.",
  "main": ".vite/build/main.js",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "cross-env ELECTRON_FORGE_PACKAGING=1 electron-forge package",
    "make": "cross-env ELECTRON_FORGE_PACKAGING=1 electron-forge make",
    "publish": "electron-forge publish",
    "lint": "oxlint",
    "lint:ci": "oxlint --quiet",
    "format": "biome format --write .",
    "rebuild": "electron-rebuild",
    "build:icon": "node build/scripts/macOS/generate-icon.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sandbox": "vitest run --pool=threads tests/integration/sandbox-ipc.integration.test.ts",
    "test:sandbox:docker": "cross-env SANDBOX_USE_DOCKER=1 vitest run --pool=threads tests/integration/sandbox-ipc.integration.test.ts",
    "test:sandbox:go:start": "bash build/sandbox/scripts/start-go-server.sh",
    "test:sandbox:go:stop": "bash build/sandbox/scripts/stop-go-server.sh",
    "test:sandbox:docker:build": "docker build -t conduit-sandbox -f build/sandbox/Dockerfile .",
    "test:sandbox:docker:start": "bash build/sandbox/scripts/start-test-container.sh",
    "test:sandbox:docker:stop": "bash build/sandbox/scripts/stop-test-container.sh",
    "postinstall": "node build/scripts/setup-keys.js",
    "prepare": "husky",
    "premake": "npm run build:icon"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.4",
    "@vitest/ui": "^4.0.4",
    "cross-env": "^10.1.0",
    "electron": "^39.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.6",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.4",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@electron-forge/publisher-github": "^7.10.2",
    "@monaco-editor/react": "^4.7.0",
    "@parcel/watcher": "^2.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/monaco": "^3.15.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "ignore": "^7.0.5",
    "immer": "^10.2.0",
    "jotai": "^2.15.0",
    "jotai-immer": "^0.4.1",
    "lucide-react": "^0.545.0",
    "monaco-editor": "^0.54.0",
    "node-pty": "^1.1.0-beta39",
    "p-retry": "^7.1.1",
    "path-browserify": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-slug": "^6.0.0",
    "remark-github-blockquote-alert": "^2.0.1",
    "shiki": "^3.15.0",
    "simple-git": "^3.30.0",
    "streamdown": "^1.6.10",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "biome format --write",
      "oxlint"
    ],
    "**/*.{json,css,md}": "biome format --write"
  }
}
