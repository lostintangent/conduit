{
  "name": "conduit",
  "productName": "Conduit",
  "description": "A terminal-centric IDE (a \"DIY-DE\"), that's built for task parallelization with coding agents.",
  "main": "dist/main/main.js",
  "version": "0.3.7",
  "private": true,
  "scripts": {
    "start": "bun build/bun.dev.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": ": ${CONDUIT_APPLE_ID_PASSWORD:?is required to sign and notarize} && electron-forge release",
    "test": "bun test --parallel",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
