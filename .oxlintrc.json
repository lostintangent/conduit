{
  "plugins": ["react", "typescript", "vitest"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "rules": {
    // Correctness rules the code doesn't pass yet. They stay warnings until
    // it does, and every other correctness rule fails `bun lint`.
    "react-hooks/immutability": "warn",
    "react-hooks/incompatible-library": "warn",
    "react-hooks/preserve-manual-memoization": "warn",
    "react-hooks/refs": "warn",
    "react-hooks/set-state-in-effect": "warn",
    "react-hooks/static-components": "warn",
    "react-hooks/use-memo": "warn",
    "react/no-did-update-set-state": "warn",
    // The React Compiler skips any component or hook these report, so the
    // build leaves it unoptimized. They stay warnings until each one compiles.
    "react-hooks/invariant": "warn",
    "react-hooks/memo-dependencies": "warn",
    "react-hooks/todo": "warn",
    // The compiler also silently skips a component whose useCallback is a
    // named function that calls itself, with no diagnostic above. Test files
    // replace this with their own no-restricted-syntax in the overrides below.
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='useCallback'] > FunctionExpression[id]",
        "message": "Pass useCallback an arrow function. The React Compiler silently skips the component when a named function here calls itself. For recursion, use a plain arrow in the component body instead."
      },
      {
        "selector": "CallExpression[callee.property.name='useCallback'] > FunctionExpression[id]",
        "message": "Pass useCallback an arrow function. The React Compiler silently skips the component when a named function here calls itself. For recursion, use a plain arrow in the component body instead."
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "no-await-in-loop": "off",
    "no-constant-condition": "off",
    "no-control-regex": "off",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/no-empty-function": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "react-hooks/exhaustive-deps": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-empty-function": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "no-restricted-syntax": [
          "error",
          {
            "selector": "NewExpression[callee.name='Promise'] > ArrowFunctionExpression CallExpression[callee.name='setTimeout'][arguments.0.type='Identifier']",
            "message": "Don't sleep for a fixed time. Wait for the outcome with waitFor, or use a signal the code under test emits."
          }
        ]
      }
    },
    {
      "files": [
        "tests/renderer/api/FileSystemV2API.test.ts",
        "src/features/git/client/GitV2API.test.ts"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["e2e/**/*.test.ts"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect*", "**.waitFor"]
          }
        ]
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "@typescript-eslint/no-non-null-assertion": "error"
      }
    },
    {
      // Tests still assert non-null on fixtures they build, including the
      // ones colocated with their feature.
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["forge.config.ts"],
      "rules": {
        "@typescript-eslint/no-var-requires": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "build/",
    "out/",
    "dist/",
    "coverage/",
    ".git/"
  ]
}
