{
  "compilerOptions": {
    "noImplicitAny": true,
    "strict": false,

    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": false,
    "types": ["node", "bun-types/vitest"],

    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"]
    }
  },
  // Files that run under Bun are checked by build/tsconfig.json with Bun types.
  "exclude": ["node_modules", "build/bun.*.ts", "tests/setup/bun-preload.ts"]
}
